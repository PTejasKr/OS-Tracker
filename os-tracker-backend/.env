# ==============================================================================
# OS-Tracker Backend Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values before running the backend.
#   cp .env.example .env
# ==============================================================================

# ---------- MongoDB ----------
# Connection URI for MongoDB. Uses local instance by default.
# For MongoDB Atlas (cloud), replace with your Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/os-tracker

# ---------- Authentication ----------
# Secret key used to sign and verify JWT tokens. Generate a strong random string.
# Example: openssl rand -hex 32
JWT_SECRET=0123456789abcdef0123456789abcdef01234567

# ---------- GitHub API (Optional) ----------
# A GitHub Personal Access Token increases the rate limit from 60 to 5000 req/hr.
# Create one at: https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# ---------- Server ----------
# Port the Express server listens on. Cloud platforms set this automatically.
PORT=5001

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins. Defaults to localhost.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001